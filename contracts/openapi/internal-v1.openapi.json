{
  "openapi": "3.1.0",
  "info": {
    "title": "MVP Oficina Recursos — API interna",
    "version": "1.0.1",
    "description": "Contratos de catálogo e reconciliação. Implementação funcional planejada para a Etapa 2."
  },
  "servers": [{"url": "http://mvp-oficina-recursos/internal/v1"}],
  "paths": {
    "/catalog/services/{service_id}": {
      "get": {
        "operationId": "getServiceSnapshot",
        "x-implementation-status": "planned-stage-2",
        "x-required-scopes": ["resources:catalog:read"],
        "security": [{"serviceBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/ServiceId"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "responses": {
          "200": {"description": "Snapshot do serviço", "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ServiceSnapshot"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "500": {"$ref": "#/components/responses/InternalError"},
          "501": {"$ref": "#/components/responses/Planned"}
        }
      }
    },
    "/catalog/resources/{resource_id}": {
      "get": {
        "operationId": "getResourceSnapshot",
        "x-implementation-status": "planned-stage-2",
        "x-required-scopes": ["resources:catalog:read"],
        "security": [{"serviceBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/ResourceId"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "responses": {
          "200": {"description": "Snapshot da peça ou insumo", "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResourceSnapshot"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "500": {"$ref": "#/components/responses/InternalError"},
          "501": {"$ref": "#/components/responses/Planned"}
        }
      }
    },
    "/operations/{operation_id}": {
      "get": {
        "operationId": "getStockOperationResult",
        "x-implementation-status": "planned-stage-2",
        "x-required-scopes": ["resources:operation:read"],
        "security": [{"serviceBearer": []}],
        "parameters": [
          {"$ref": "#/components/parameters/OperationId"},
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "responses": {
          "200": {"description": "Resultado autoritativo e idempotente", "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationResult"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/Forbidden"},
          "404": {"$ref": "#/components/responses/NotFound"},
          "422": {"$ref": "#/components/responses/ValidationError"},
          "500": {"$ref": "#/components/responses/InternalError"},
          "501": {"$ref": "#/components/responses/Planned"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "serviceBearer": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    },
    "parameters": {
      "ServiceId": {"name": "service_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "ResourceId": {"name": "resource_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "OperationId": {"name": "operation_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "CorrelationId": {"name": "X-Correlation-ID", "in": "header", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "Mesma chave e payload devolvem o mesmo resultado; payload divergente gera 409.",
        "schema": {"type": "string", "minLength": 8, "maxLength": 128}
      }
    },
    "headers": {
      "CorrelationId": {"schema": {"type": "string", "format": "uuid"}}
    },
    "schemas": {
      "ServiceSnapshot": {
        "type": "object",
        "required": ["service_id", "name", "description", "price", "version"],
        "properties": {
          "service_id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "description": {"type": ["string", "null"]},
          "price": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{2})$"},
          "version": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      },
      "ResourceSnapshot": {
        "type": "object",
        "required": ["resource_id", "name", "description", "unit_price", "version"],
        "properties": {
          "resource_id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "description": {"type": ["string", "null"]},
          "unit_price": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{2})$"},
          "version": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      },
      "OperationResult": {
        "type": "object",
        "required": ["operation_id", "operation_type", "status", "result", "updated_at"],
        "properties": {
          "operation_id": {"type": "string", "format": "uuid"},
          "operation_type": {"enum": ["RESERVE", "RELEASE", "RECEIVE_BACKORDERED", "CONSUME"]},
          "status": {"enum": ["PENDING", "COMPLETED", "REJECTED", "RECONCILIATION_REQUIRED"]},
          "result": {"type": ["object", "null"]},
          "updated_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "required": ["code", "message", "correlation_id"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "message": {"type": "string", "minLength": 1, "maxLength": 512},
          "correlation_id": {"type": "string", "format": "uuid"},
          "operation_id": {
            "oneOf": [
              {"type": "string", "format": "uuid"},
              {"type": "null"}
            ]
          },
          "details": {"type": "object", "additionalProperties": true}
        },
        "additionalProperties": false
      }
    },
    "responses": {
      "Unauthorized": {"description": "Token ausente, inválido, expirado, de tipo incorreto ou para outra audiência", "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
      "Forbidden": {"description": "Escopo insuficiente", "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
      "NotFound": {"description": "Recurso ou operação não encontrado", "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
      "ValidationError": {"description": "Header, parâmetro ou corpo da requisição inválido", "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
      "InternalError": {"description": "Falha interna sem exposição de detalhes sensíveis", "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
      "Planned": {"description": "Contrato materializado; integração funcional pertence à Etapa 2", "headers": {"X-Correlation-ID": {"$ref": "#/components/headers/CorrelationId"}}, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}
    }
  }
}

